#!/usr/bin/env python3
"""swarm-spawn — CLI for requesting a heavy subagent spawn.

Usage:
    swarm-spawn --parent <parent_id> --depth <N> --mission <text> \
                [--max-depth <N>] [--max-live <N>] [--fanout <N>] \
                [--session <session_id>] [--summary <text>] [--dry-run]

Returns admission verdict (admit | queue | reject) and, on admit, spawns
the child via subprocess and registers it in the session's tree.json.

This is a thin wrapper over swarm.specialists.spawner. Tests exercise it
via subprocess and via direct import.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import uuid
from pathlib import Path

# Ensure swarm package importable (when run via symlink / installed location)
_REPO_ROOT = Path(__file__).resolve().parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from swarm.schemas.mission import Concurrency  # noqa: E402
from swarm.specialists.spawner import (  # noqa: E402
    AdmissionResult,
    SpawnRequest,
    admit_spawn,
    enqueue,
    load_tree,
    register_spawn,
)


def _parse_args(argv: list[str]) -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Request a heavy subagent spawn")
    p.add_argument("--parent", required=True, help="Parent session/spawner id")
    p.add_argument("--depth", type=int, required=True, help="Subagent depth")
    p.add_argument("--mission", required=True, help="Mission prose for child")
    p.add_argument("--summary", default="", help="Context summary to pass")
    p.add_argument("--session", default=None, help="Session to register in (defaults to SESSION_ID env)")
    p.add_argument("--max-depth", type=int, default=8)
    p.add_argument("--max-live", type=int, default=16)
    p.add_argument("--fanout", type=int, default=4)
    p.add_argument(
        "--dry-run",
        action="store_true",
        help="Only report admission verdict; do not actually spawn",
    )
    return p.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = _parse_args(argv or sys.argv[1:])
    session = args.session or os.environ.get("SESSION_ID", "")
    if not session:
        print("ERROR: --session or SESSION_ID env required", file=sys.stderr)
        return 2

    concurrency = Concurrency(
        max_total_live=args.max_live,
        max_depth=args.max_depth,
        max_fan_out_per_parent=args.fanout,
    )
    request = SpawnRequest(
        parent_id=args.parent,
        depth=args.depth,
        mission=args.mission,
        context_summary=args.summary,
    )

    state = load_tree(session)
    verdict = admit_spawn(state, request, concurrency)

    result: dict = {
        "verdict": verdict.value,
        "session": session,
        "parent": args.parent,
        "depth": args.depth,
    }

    if verdict == AdmissionResult.REJECT:
        result["reason"] = f"depth {args.depth} exceeds max_depth {args.max_depth}"
        print(json.dumps(result))
        return 3  # reject → non-zero

    if verdict == AdmissionResult.QUEUE:
        enqueue(session, state, request)
        result["reason"] = "queued: at budget"
        print(json.dumps(result))
        return 0

    # ADMIT
    child_id = uuid.uuid4().hex[:12]
    if args.dry_run:
        result["child_id"] = child_id
        result["dry_run"] = True
        print(json.dumps(result))
        return 0

    # In v3, we don't actually spawn claude here — that's the spawner daemon's
    # job (deferred to v4). For now register the intent; a future daemon
    # consumes the registration and does the actual process launch.
    register_spawn(session, state, request, child_id, pid=0)
    result["child_id"] = child_id
    result["note"] = "registered; real subprocess spawn deferred to spawner daemon"
    print(json.dumps(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
