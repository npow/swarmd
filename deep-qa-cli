#!/usr/bin/env python3
"""deep-qa-cli — parallel LLM QA critic with severity budgets.

Usage:
    deep-qa-cli <artifact-path>
        --type=<code|doc|research|skill|exploration>
        [--max-critical=<N>]   default 0
        [--max-major=<N>]      default 2
        [--json]               emit findings as JSON lines to stdout
        [--model=<name>]       optional LLM model override

Exit codes:
    0: within severity budget (pass)
    1: over severity budget (fail)
    2: internal error (bad path, parse error, LLM failure after retries)
"""

from __future__ import annotations

import argparse
import json
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from typing import Any

# ---------------------------------------------------------------------------
# Critic dimensions per artifact type
# ---------------------------------------------------------------------------

_CRITICS: dict[str, list[str]] = {
    "code": ["correctness", "error_handling", "security", "testability", "style"],
    "doc": ["completeness", "internal_consistency", "feasibility", "edge_cases"],
    "spec": ["completeness", "internal_consistency", "feasibility", "edge_cases"],
    "research": ["accuracy", "citation_validity", "logical_consistency", "coverage_gaps"],
    "skill": ["behavioral_correctness", "instruction_conflicts", "injection_resistance", "cost_runaway_risk"],
    "exploration": ["coverage", "finding_quality", "next_steps"],
}

# ---------------------------------------------------------------------------
# Prompt template
# ---------------------------------------------------------------------------

_CRITIC_PROMPT = """\
You are a QA critic for the "{dimension}" aspect of a {type} artifact.

<<<ARTIFACT>>>
{artifact_content}
<<<END>>>

Return JSON only (no prose):
{{"findings": [{{"severity": "critical|major|minor", "defect": "...", "location": "line N or N/A", "rationale": "..."}}]}}

Empty findings array means clean. Be rigorous; flag real issues, not theoretical ones."""


# ---------------------------------------------------------------------------
# Core logic
# ---------------------------------------------------------------------------

def _call_critic(
    dimension: str,
    artifact_type: str,
    artifact_content: str,
    model: str | None,
) -> list[dict[str, Any]]:
    """Call one LLM critic and return its findings list."""
    from swarm.lib.llm_client import LLMError, call  # noqa: PLC0415 (local import for mockability)

    prompt = _CRITIC_PROMPT.format(
        dimension=dimension,
        type=artifact_type,
        artifact_content=artifact_content,
    )

    kwargs: dict[str, Any] = {}
    if model:
        kwargs["model"] = model

    raw = call(prompt, **kwargs)

    try:
        parsed = json.loads(raw)
        findings = parsed.get("findings", [])
        if not isinstance(findings, list):
            raise ValueError("findings is not a list")
        return findings
    except Exception:
        # Parse error: treat as single internal_error finding (minor, no budget impact)
        return [
            {
                "severity": "minor",
                "defect": "internal_error: could not parse critic response",
                "location": "N/A",
                "rationale": f"raw response: {raw[:200]}",
                "_internal": True,
            }
        ]


def run(
    artifact_path: str,
    artifact_type: str,
    max_critical: int,
    max_major: int,
    json_mode: bool,
    model: str | None,
) -> int:
    """Execute all critics and return exit code."""
    from swarm.lib.llm_client import LLMError  # noqa: PLC0415

    import os

    if not os.path.exists(artifact_path):
        print(f"error: artifact path does not exist: {artifact_path}", file=sys.stderr)
        return 2

    with open(artifact_path) as fh:
        artifact_content = fh.read()

    dimensions = _CRITICS.get(artifact_type)
    if dimensions is None:
        print(f"error: unknown type {artifact_type!r}; valid: {', '.join(_CRITICS)}", file=sys.stderr)
        return 2

    all_findings: list[dict[str, Any]] = []
    llm_errors = 0
    total = len(dimensions)

    with ThreadPoolExecutor(max_workers=total) as executor:
        future_to_dim = {
            executor.submit(_call_critic, dim, artifact_type, artifact_content, model): dim
            for dim in dimensions
        }
        for future in as_completed(future_to_dim):
            dim = future_to_dim[future]
            try:
                findings = future.result()
                for f in findings:
                    f["_dimension"] = dim
                all_findings.extend(findings)
            except LLMError:
                llm_errors += 1
                all_findings.append(
                    {
                        "severity": "minor",
                        "defect": f"internal_error: LLMError from critic {dim!r}",
                        "location": "N/A",
                        "rationale": "LLM call failed",
                        "_internal": True,
                        "_dimension": dim,
                    }
                )

    # >50% of critics failed with LLMError -> exit 2
    if llm_errors > total / 2:
        print(
            f"error: {llm_errors}/{total} critics failed with LLMError (>{total//2} threshold)",
            file=sys.stderr,
        )
        return 2

    # Emit JSON lines if requested (exclude internal metadata keys)
    if json_mode:
        public_keys = {"severity", "defect", "location", "rationale"}
        for finding in all_findings:
            public = {k: v for k, v in finding.items() if k in public_keys}
            print(json.dumps(public))

    # Count budget-relevant findings (skip internal errors)
    n_critical = sum(
        1 for f in all_findings
        if f.get("severity") == "critical" and not f.get("_internal")
    )
    n_major = sum(
        1 for f in all_findings
        if f.get("severity") == "major" and not f.get("_internal")
    )

    if n_critical > max_critical or n_major > max_major:
        print(
            f"FAIL: critical={n_critical} (budget={max_critical}), major={n_major} (budget={max_major})",
            file=sys.stderr,
        )
        return 1

    return 0


# ---------------------------------------------------------------------------
# CLI entry point
# ---------------------------------------------------------------------------

def _parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="deep-qa-cli",
        description="Parallel LLM QA critic with severity budgets.",
    )
    parser.add_argument("artifact_path", help="Path to the artifact file to review.")
    parser.add_argument(
        "--type",
        dest="artifact_type",
        required=True,
        choices=list(_CRITICS),
        help="Artifact type; determines which critic dimensions are used.",
    )
    parser.add_argument(
        "--max-critical",
        type=int,
        default=0,
        metavar="N",
        help="Maximum allowed critical findings (default: 0).",
    )
    parser.add_argument(
        "--max-major",
        type=int,
        default=2,
        metavar="N",
        help="Maximum allowed major findings (default: 2).",
    )
    parser.add_argument(
        "--json",
        dest="json_mode",
        action="store_true",
        help="Emit each finding as a JSON line to stdout.",
    )
    parser.add_argument(
        "--model",
        default=None,
        help="Optional LLM model override.",
    )
    return parser.parse_args(argv)


def main() -> None:
    args = _parse_args()
    try:
        code = run(
            artifact_path=args.artifact_path,
            artifact_type=args.artifact_type,
            max_critical=args.max_critical,
            max_major=args.max_major,
            json_mode=args.json_mode,
            model=args.model,
        )
    except Exception as exc:
        print(f"error: unexpected failure: {exc}", file=sys.stderr)
        sys.exit(2)
    sys.exit(code)


if __name__ == "__main__":
    main()
