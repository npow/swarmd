{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "deny": [
      "Read(~/.swarm/**)",
      "Write(~/.swarm/**)",
      "Edit(~/.swarm/**)",
      "Glob(~/.swarm/**)",
      "Grep(~/.swarm/**)",
      "Read(~/.config/swarm/**)",
      "Write(~/.config/swarm/**)",
      "Edit(~/.config/swarm/**)",
      "Glob(~/.config/swarm/**)",
      "Grep(~/.config/swarm/**)",
      "Read(.claude/settings.json)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Glob(.claude/**)",
      "Bash(cat ~/.swarm/*)",
      "Bash(cat ~/.swarm)",
      "Bash(ls ~/.swarm*)",
      "Bash(less ~/.swarm*)",
      "Bash(more ~/.swarm*)",
      "Bash(head ~/.swarm*)",
      "Bash(tail ~/.swarm*)",
      "Bash(grep * ~/.swarm*)",
      "Bash(find ~/.swarm*)",
      "Bash(echo * > ~/.swarm*)",
      "Bash(echo * >> ~/.swarm*)",
      "Bash(tee ~/.swarm*)",
      "Bash(cp * ~/.swarm*)",
      "Bash(mv * ~/.swarm*)",
      "Bash(rm ~/.swarm*)",
      "Bash(rm -rf ~/.swarm*)",
      "Bash(truncate * ~/.swarm*)",
      "Bash(sed -i* ~/.swarm*)",
      "Bash(chmod * ~/.swarm*)",
      "Bash(chflags * ~/.swarm*)",
      "Bash(chattr * ~/.swarm*)",
      "Bash(ln -s * ~/.swarm*)",
      "Bash(cat ~/.config/swarm*)",
      "Bash(ls ~/.config/swarm*)",
      "Bash(echo * > ~/.config/swarm*)",
      "Bash(rm ~/.config/swarm*)",
      "Bash(cat .claude/**)",
      "Bash(echo * > .claude/**)",
      "Bash(claude --bare*)",
      "Bash(claude -p --bare*)",
      "Bash(claude *--bare*)",
      "Bash(sudo *)",
      "Bash(sudo)",
      "Bash(su -*)",
      "Bash(doas *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(killall *)",
      "Bash(export SWARM_*)",
      "Bash(export SESSION_ID*)",
      "Bash(SWARM_ROOT=*)",
      "Bash(SWARM_CONFIG=*)",
      "Bash(SESSION_ID=*)",
      "Bash(unset SWARM_*)",
      "Bash(unset SESSION_*)",
      "Bash(python -c *swarm*)",
      "Bash(python3 -c *swarm*)",
      "Bash(python -c *.swarm*)",
      "Bash(python3 -c *.swarm*)",
      "Bash(perl -e *swarm*)",
      "Bash(ruby -e *swarm*)",
      "Bash(node -e *swarm*)",
      "Bash(node -p *swarm*)",
      "Bash(dd * ~/.swarm*)",
      "Bash(dd * ~/.config/swarm*)",
      "Bash(curl *api.anthropic*)",
      "Bash(curl *api.openai*)",
      "Bash(curl *generativelanguage.googleapis*)",
      "Bash(wget *api.anthropic*)",
      "Bash(wget *api.openai*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/code/research/swarm/hooks/on_session_start.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/code/research/swarm/hooks/on_post_tool_use.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/code/research/swarm/hooks/on_stop.py"
          }
        ]
      }
    ]
  }
}
