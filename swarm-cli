#!/usr/bin/env python3
"""swarm-cli — admin tool for inspecting and managing swarm sessions.

Usage:
    swarm-cli list-sessions
    swarm-cli inspect <session_id>
    swarm-cli tree <session_id>
    swarm-cli kill <session_id>
    swarm-cli gc
    swarm-cli revise-mission <session_id> <new_mission_yaml>
    swarm-cli promote <version>
"""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from swarm.lib.hashing import sha256_file  # noqa: E402
from swarm.lib.launcher_liveness import launcher_alive  # noqa: E402
from swarm.lib.paths import (  # noqa: E402
    mission_lock_path,
    mission_yaml_path,
    out_of_tree_lock_path,
    session_dir,
    swarm_root,
    validate_session_id,
)


def cmd_list_sessions(args: argparse.Namespace) -> int:
    state_root = swarm_root() / "state"
    if not state_root.exists():
        print("No sessions found")
        return 0
    sessions = sorted([p.name for p in state_root.iterdir() if p.is_dir()])
    if not sessions:
        print("No sessions found")
        return 0
    print(f"{len(sessions)} sessions:")
    for s in sessions:
        sdir = state_root / s
        mission = mission_yaml_path(s)
        mission_name = "(none)"
        if mission.exists():
            try:
                import yaml

                data = yaml.safe_load(mission.read_text())
                mission_name = (data.get("mission") or "")[:60] + "..."
            except Exception:
                mission_name = "(unreadable)"
        print(f"  {s}  {mission_name}")
    return 0


def cmd_inspect(args: argparse.Namespace) -> int:
    session_id = args.session_id
    try:
        validate_session_id(session_id)
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 2
    sdir = session_dir(session_id)
    if not sdir.exists():
        print(f"ERROR: session {session_id} not found", file=sys.stderr)
        return 1
    info: dict = {"session_id": session_id, "dir": str(sdir)}
    # Mission
    mpath = mission_yaml_path(session_id)
    info["mission_yaml_exists"] = mpath.exists()
    # Verifier status
    vstat = sdir / "verifier_status.json"
    if vstat.exists():
        try:
            info["verifier_status"] = json.loads(vstat.read_text())
        except Exception:
            info["verifier_status"] = "(unparseable)"
    # Counts
    for name in ("events.jsonl", "findings.jsonl", "interventions.jsonl"):
        p = sdir / name
        if p.exists():
            info[f"{name}_lines"] = sum(1 for _ in p.open())
    # Strikes
    strikes = sdir / "strikes.json"
    if strikes.exists():
        try:
            info["strikes"] = json.loads(strikes.read_text())
        except Exception:
            info["strikes"] = "(unparseable)"
    # Health beats
    health_dir = sdir / "health"
    if health_dir.exists():
        info["specialists_seen"] = sorted([p.stem for p in health_dir.iterdir()])
    print(json.dumps(info, indent=2))
    return 0


def cmd_tree(args: argparse.Namespace) -> int:
    session_id = args.session_id
    try:
        validate_session_id(session_id)
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 2
    tree_file = session_dir(session_id) / "tree.json"
    if not tree_file.exists():
        print(f"No tree for session {session_id} (no subagents spawned)")
        return 0
    try:
        data = json.loads(tree_file.read_text())
    except Exception as e:
        print(f"ERROR reading tree: {e}", file=sys.stderr)
        return 1
    print(json.dumps(data, indent=2))
    return 0


def cmd_kill(args: argparse.Namespace) -> int:
    session_id = args.session_id
    try:
        validate_session_id(session_id)
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 2
    sdir = session_dir(session_id)
    if not sdir.exists():
        print(f"ERROR: session {session_id} not found", file=sys.stderr)
        return 1
    killed = 0
    # Collect PIDs from health beats
    health_dir = sdir / "health"
    if health_dir.exists():
        for beat_file in health_dir.glob("*.beat"):
            try:
                data = json.loads(beat_file.read_text())
                pid = int(data.get("pid", 0))
                if pid > 0:
                    os.kill(pid, signal.SIGTERM)
                    killed += 1
                    print(f"  SIGTERM → pid={pid} ({beat_file.stem})")
            except (ProcessLookupError, OSError, ValueError):
                continue
    # Also kill any subagents from tree
    tree_file = sdir / "tree.json"
    if tree_file.exists():
        try:
            tree = json.loads(tree_file.read_text())
            for child_id, node in tree.get("nodes", {}).items():
                if node.get("status") == "running":
                    pid = int(node.get("pid", 0))
                    if pid > 0:
                        try:
                            os.kill(pid, signal.SIGTERM)
                            killed += 1
                            print(f"  SIGTERM → pid={pid} (child {child_id})")
                        except (ProcessLookupError, OSError):
                            continue
        except Exception:
            pass
    print(f"Sent SIGTERM to {killed} processes")
    return 0 if killed > 0 else 1


def cmd_revise_mission(args: argparse.Namespace) -> int:
    session_id = args.session_id
    new_mission = Path(args.new_mission_yaml)
    try:
        validate_session_id(session_id)
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        return 2
    if not new_mission.exists():
        print(f"ERROR: {new_mission} does not exist", file=sys.stderr)
        return 1
    dest = mission_yaml_path(session_id)
    # Validate the new mission first
    try:
        import yaml

        from swarm.schemas.mission import Mission

        Mission.model_validate(yaml.safe_load(new_mission.read_text()))
    except Exception as e:
        print(f"ERROR: new mission invalid: {e}", file=sys.stderr)
        return 1
    # Back up current mission
    if dest.exists():
        backup = dest.with_suffix(".yaml.bak")
        backup.write_bytes(dest.read_bytes())
        print(f"Backed up {dest} → {backup}")
    dest.write_bytes(new_mission.read_bytes())
    # Re-pin hash
    lock_file = mission_lock_path(session_id)
    if lock_file.exists():
        lock = json.loads(lock_file.read_text())
        lock["files"]["mission.yaml"] = sha256_file(dest)
        lock_file.write_text(json.dumps(lock, indent=2))
        # Update out-of-tree lock
        out_lock = out_of_tree_lock_path(session_id)
        out_lock.write_text(json.dumps(lock["files"], sort_keys=True))
        print(f"Updated hash pins for {dest}")
    print("Mission revised.")
    return 0


def _find_specialist_processes() -> list[tuple[int, str, str | None]]:
    """Scan `ps` for running `swarm.specialists.*` processes.

    Returns a list of (pid, command_line, session_id) tuples. `session_id`
    is the first argv token that matches the session_id shape; None if not
    found (rare — indicates a malformed or mid-crash process).
    """
    try:
        result = subprocess.run(
            ["ps", "-eo", "pid=,command="],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return []
    hits: list[tuple[int, str, str | None]] = []
    for line in result.stdout.splitlines():
        if "swarm.specialists." not in line:
            continue
        parts = line.strip().split(maxsplit=1)
        if len(parts) < 2:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        command = parts[1]
        # Session id is the trailing uuid-shaped token. Match known forms.
        sid: str | None = None
        for token in reversed(command.split()):
            try:
                validate_session_id(token)
                sid = token
                break
            except ValueError:
                continue
        hits.append((pid, command, sid))
    return hits


def cmd_gc(args: argparse.Namespace) -> int:
    """Kill any `swarm.specialists.*` processes whose launcher is dead.

    This is the post-hoc cleanup path for daemons that leaked past the
    bash trap — SIGKILL on the launcher, terminal SIGHUP, or machine crash.
    Safe to run at any time: it never touches processes whose launcher pid
    is still alive.
    """
    dry_run = bool(getattr(args, "dry_run", False))
    my_pid = os.getpid()
    hits = _find_specialist_processes()
    orphans: list[tuple[int, str, str | None]] = []
    for pid, command, sid in hits:
        if pid == my_pid:
            continue
        # Treat as orphan if:
        #   - no session_id parsed out of argv, OR
        #   - session_id has no state dir, OR
        #   - state dir exists but launcher.pid is missing or dead.
        if sid is None:
            orphans.append((pid, command, None))
            continue
        if not session_dir(sid).exists():
            orphans.append((pid, command, sid))
            continue
        if not launcher_alive(sid):
            orphans.append((pid, command, sid))
            continue

    if not orphans:
        print("No orphaned specialists found. (scanned %d running)" % len(hits))
        return 0

    action = "would kill" if dry_run else "killing"
    print(f"{action} {len(orphans)} orphan specialist(s):")
    for pid, command, sid in orphans:
        tag = f"session={sid}" if sid else "session=?"
        print(f"  pid={pid} {tag} cmd={command[:120]}")

    if dry_run:
        return 0

    killed = 0
    # SIGTERM first, then SIGKILL after a short grace period.
    for pid, _, _ in orphans:
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            continue
        except PermissionError:
            print(f"  (no permission to signal pid={pid}; skipping)")
            continue
    time.sleep(2)
    for pid, _, _ in orphans:
        try:
            os.kill(pid, 0)  # still alive?
        except ProcessLookupError:
            killed += 1
            continue
        except PermissionError:
            continue
        # Still alive — escalate.
        try:
            os.kill(pid, signal.SIGKILL)
            killed += 1
        except ProcessLookupError:
            killed += 1
        except PermissionError:
            print(f"  (no permission to SIGKILL pid={pid})")
            continue
    print(f"killed {killed} orphan specialist(s)")
    return 0


def cmd_promote(args: argparse.Namespace) -> int:
    """Promote a staged swarm version. v5 stub: logs intent."""
    version = args.version
    # Staging path per the spec (§11)
    staging = Path.home() / ".swarm-staging" / version
    versions_dir = Path.home() / ".swarm-versions"
    active = Path.home() / ".swarm"
    if not staging.exists():
        print(f"ERROR: no staged version at {staging}", file=sys.stderr)
        return 1
    target = versions_dir / version
    if target.exists():
        print(f"ERROR: {target} already exists", file=sys.stderr)
        return 1
    print(
        f"Would promote {staging} → {target} and update symlink {active} → {target}.\n"
        "Promotion execution deferred; this command validates readiness only."
    )
    # Validate: the staged version should have a CLAUDE.md or at least a
    # launch.sh to be considered "ready."
    if not (staging / "launch.sh").exists():
        print(f"ERROR: staged version missing launch.sh", file=sys.stderr)
        return 1
    print("Staged version passes readiness check.")
    return 0


def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(description="Swarm admin CLI")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list-sessions", help="List all known sessions")

    inspect = sub.add_parser("inspect", help="Dump session state as JSON")
    inspect.add_argument("session_id")

    tree = sub.add_parser("tree", help="Show subagent process tree")
    tree.add_argument("session_id")

    kill = sub.add_parser("kill", help="SIGTERM all specialists + subagents for a session")
    kill.add_argument("session_id")

    gc = sub.add_parser(
        "gc",
        help="Kill any running specialist daemons whose launcher pid is dead",
    )
    gc.add_argument(
        "--dry-run",
        action="store_true",
        help="Report what would be killed without actually signalling",
    )

    revise = sub.add_parser("revise-mission", help="Replace mission.yaml for a live session")
    revise.add_argument("session_id")
    revise.add_argument("new_mission_yaml")

    promote = sub.add_parser("promote", help="Promote a staged swarm version")
    promote.add_argument("version")

    args = p.parse_args(argv)

    handlers = {
        "list-sessions": cmd_list_sessions,
        "inspect": cmd_inspect,
        "tree": cmd_tree,
        "kill": cmd_kill,
        "gc": cmd_gc,
        "revise-mission": cmd_revise_mission,
        "promote": cmd_promote,
    }
    return handlers[args.cmd](args)


if __name__ == "__main__":
    sys.exit(main())
