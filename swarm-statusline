#!/usr/bin/env python3
"""swarm-statusline — executable wrapper that self-configures sys.path so
the Claude Code statusLine hook can invoke it directly by absolute path."""

from __future__ import annotations

import sys
from pathlib import Path

_REPO_ROOT = Path(__file__).resolve().parent.parent
if str(_REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(_REPO_ROOT))

from swarm.statusline import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
